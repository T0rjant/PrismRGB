<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <Authors>Torjant</Authors>
    <Company>Torjant</Company>
    <Product>PrismRGB</Product>
    <Copyright>Copyright (C) 2026 Torjant - GPL-3.0-or-later</Copyright>
    <RepositoryUrl>https://github.com/T0rjant/PrismRGB</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>
</Project>
